# Copy to .env.local for local development. Never commit real values.

# Canonical production origin used for canonical URLs, sitemap, robots.txt,
# structured data and llms.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.mabglobalpartners.com

# Indexing is enabled only when VERCEL_ENV=production (set by Vercel) or
# SITE_ENV=production (self-hosted production builds). Leave empty locally.
SITE_ENV=

# AI crawler policy. "false" disallows model-training crawlers (GPTBot,
# ClaudeBot, Google-Extended, Applebot-Extended, CCBot) while keeping search
# and user-initiated agents allowed. Default when empty: allowed.
ALLOW_AI_TRAINING_CRAWLERS=

# Contact form email delivery (Resend, provisioned through the Vercel
# Marketplace integration resend/resend-email). The form reports
# "not configured" until all three values are present.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "MAB Global Partners <form@mabglobalpartners.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives consultation requests.
CONTACT_TO_EMAIL=info@mabglobalpartners.com

# Optional comma-separated extra origins allowed to POST /api/contact
# (for example a staging domain). Vercel deployment URLs are allowed automatically.
CONTACT_ALLOWED_ORIGINS=
